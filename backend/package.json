{
  "name": "backend-labs",
  "private": true,
  "type": "module",
  "description": "The backend labs: a real Postgres, a real Redis, and services you can break on purpose.",
  "scripts": {
    "up": "docker compose up -d --wait",
    "down": "docker compose down",
    "reset": "docker compose down -v && docker compose up -d --wait && npm run seed",
    "seed": "node db/seed.mjs",
    "psql": "docker compose exec pg psql -U labs -d labs",
    "test:api": "node --test api-craft/test/",
    "drills:pg": "node postgres/drills/run.mjs",
    "drills:cache": "node caching-and-queues/drills/run.mjs",
    "drills:sec": "node auth-and-security/drills/run.mjs",
    "drills:jobs": "node jobs-and-messaging/drills/run.mjs",
    "drills:api": "node api-styles/drills/run.mjs",
    "drills:rt": "node realtime/drills/run.mjs",
    "drills:node": "node node-runtime/drills/run.mjs",
    "drills:go": "cd go-concurrency && go test -race ./...",
    "drills:golang": "cd go-lang && go test -race ./...",
    "test:reliability": "node --test reliability/test/",
    "lab:go-profiling": "cd go-lang && go run ./labs/01-profiling"
  },
  "dependencies": {
    "fastify": "^5.12.1",
    "graphql": "^16.14.2",
    "ioredis": "^6.0.0",
    "postgres": "^3.4.5",
    "zod": "^4.4.3"
  }
}
